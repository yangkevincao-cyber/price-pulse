{
    "name": "price-pulse-backend",
    "version": "1.0.0",
    "description": "PricePulse Backend API",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "dev": "nodemon src/app.js",
        "build": "npm run lint && npm run test",
        "lint": "eslint \"src/**/*.js\"",
        "lint:fix": "eslint \"src/**/*.js\" --fix",
        "format": "prettier --write \"src/**/*.js\"",
        "test": "NODE_ENV=test jest --coverage --passWithNoTests",
        "test:watch": "NODE_ENV=test jest --watch",
        "test:unit": "NODE_ENV=test jest tests/unit --passWithNoTests",
        "test:integration": "NODE_ENV=test jest tests/integration --passWithNoTests",
        "migrate": "node scripts/migrate.js up",
        "seed": "node scripts/seedDev.js",
        "init:db": "node scripts/initDb.js",
        "create:admin": "node scripts/createAdmin.js"
    },
    "devDependencies": {
        "eslint": "^8.48.0",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.6.4",
        "nodemon": "^3.0.1",
        "prettier": "^3.9.9",
        "supertest": "^6.3.3"
    }
}
