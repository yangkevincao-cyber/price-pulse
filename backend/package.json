{
    "name": "pricepulse-backend",
    "version": "1.0.0",
    "description": "PricePulse Backend API - Intelligent marketplace with demand alerts, price comparison, and smart exchanges",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "dev": "nodemon src/app.js",
        "test": "NODE_ENV=test jest --coverage",
        "test:watch": "NODE_ENV=test jest --watch",
        "test:ci": "NODE_ENV=test jest --coverage --ci --maxWorkers=2",
        "test:unit": "NODE_ENV=test jest tests/unit",
        "test:integration": "NODE_ENV=test jest tests/integration",
        "test:coverage": "NODE_ENV=test jest --coverage --coverageDirectory=coverage",
        "lint": "eslint src/**/*.js",
        "format": "prettier --write src/**/*.js",
        "migrate": "node scripts/migrate.js up",
        "migrate:undo": "node scripts/migrate.js down",
        "migrate:status": "node scripts/migrate.js status",
        "migrate:redo": "node scripts/migrate.js redo",
        "seed": "node scripts/seedDev.js",
        "seed:prod": "NODE_ENV=production node scripts/seedDev.js",
        "init:db": "node scripts/initDb.js",
        "create:admin": "node scripts/createAdmin.js",
        "generate:sitemap": "node scripts/generateSitemap.js",
        "backup:db": "node scripts/backupDb.js",
        "worker": "node src/workers/index.js",
        "worker:email": "node src/workers/emailWorker.js",
        "worker:scraping": "node src/workers/scrapingWorker.js",
        "worker:analytics": "node src/workers/analyticsWorker.js",
        "worker:notification": "node src/workers/notificationWorker.js",
        "worker:price": "node src/workers/priceUpdateWorker.js",
        "worker:fraud": "node src/workers/fraudDetectionWorker.js",
        "job": "node src/jobs/index.js",
        "job:daily": "node -e \"require('./src/jobs/dailyDigest').run()\"",
        "job:weekly": "node -e \"require('./src/jobs/weeklyReport').run()\"",
        "job:scrape": "node -e \"require('./src/jobs/priceScraper').run()\"",
        "job:alerts": "node -e \"require('./src/jobs/demandAlertGenerator').run()\"",
        "job:cleanup": "node -e \"require('./src/jobs/cleanupExpired').run()\"",
        "job:matches": "node -e \"require('./src/jobs/exchangeMatchFinder').run()\"",
        "job:metrics": "node -e \"require('./src/jobs/metricsAggregator').run()\"",
        "logs:clean": "node scripts/cleanLogs.js",
        "logs:analyze": "node scripts/analyzeLogs.js",
        "logs:tail": "tail -f logs/combined.log",
        "logs:error": "tail -f logs/error.log",
        "logs:access": "tail -f logs/access.log",
        "logs:today": "grep \"$(date +%Y-%m-%d)\" logs/combined.log",
        "logs:errors-today": "grep \"$(date +%Y-%m-%d)\" logs/error.log",
        "logs:count": "wc -l logs/*.log",
        "logs:size": "du -sh logs/",
        "env:dev": "NODE_ENV=development nodemon src/app.js",
        "env:prod": "NODE_ENV=production node src/app.js",
        "env:test": "NODE_ENV=test jest",
        "db:seed": "node scripts/seedDev.js",
        "db:backup": "node scripts/backupDb.js",
        "db:restore": "node scripts/restoreDb.js",
        "monitor": "node scripts/monitor.js",
        "health": "node scripts/healthCheck.js",
        "clean": "rm -rf node_modules && npm install",
        "build": "npm run lint && npm run test",
        "deploy": "npm run migrate && npm run seed:prod",
        "reset": "npm run migrate:undo && npm run migrate && npm run seed",
        "setup": "npm install && npm run init:db && npm run create:admin",
        "update": "git pull && npm install && npm run migrate",
        "uploads:clean": "node scripts/cleanUploads.js",
        "uploads:stats": "node -e \"require('./src/services/file/uploadService').getStats().then(console.log)\"",
        "uploads:clean-temp": "node -e \"require('./src/services/file/uploadService').cleanTempFiles().then(console.log)\""
    },
    "dependencies": {
        "@sendgrid/mail": "^7.7.0",
        "axios": "^1.5.0",
        "bcryptjs": "^2.4.3",
        "bullmq": "^5.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^6.10.0",
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^3.0.2",
        "nodemailer": "^6.9.5",
        "pg": "^8.11.3",
        "pg-hstore": "^2.3.4",
        "prom-client": "^14.2.0",
        "redis": "^4.6.10",
        "resend": "^2.1.0",
        "sequelize": "^6.33.0",
        "socket.io": "^4.7.2",
        "stripe": "^14.12.0",
        "uuid": "^9.0.0",
        "winston": "^3.10.0",
        "xss": "^1.0.14",
        "yup": "^1.3.3"
    },
    "devDependencies": {
        "eslint": "^8.48.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.6.4",
        "nodemon": "^3.0.1",
        "prettier": "^3.0.3",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}