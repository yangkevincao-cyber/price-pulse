{
    "name": "price-pulse-backend",
    "version": "1.0.0",
    "description": "PricePulse Backend API",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "dev": "nodemon src/app.js",
        "build": "npm run lint",
        "lint": "eslint \"src/**/*.js\"",
        "lint:fix": "eslint \"src/**/*.js\" --fix",
        "format": "prettier --write \"src/**/*.js\"",
        "test": "NODE_ENV=test jest --coverage --passWithNoTests",
        "test:watch": "NODE_ENV=test jest --watch",
        "test:unit": "NODE_ENV=test jest tests/unit --passWithNoTests",
        "test:integration": "NODE_ENV=test jest tests/integration --passWithNoTests",
        "migrate": "node scripts/migrate.js up",
        "seed": "node scripts/seedDev.js",
        "init:db": "node scripts/initDb.js",
        "create:admin": "node scripts/createAdmin.js"
    },
    "devDependencies": {
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.6.4",
        "nodemon": "^3.0.1",
        "prettier": "^3.9.9",
        "supertest": "^6.3.3"
    },
    "dependencies": {
        "@sendgrid/mail": "^8.1.6",
        "axios": "^1.21.1",
        "bcryptjs": "^3.0.3",
        "bullmq": "^6.7.3",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.4",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.5.0",
        "node-cron": "^4.6.0",
        "nodemailer": "^10.5.0",
        "pg": "^8.23.1",
        "pg-hstore": "^2.3.4",
        "prom-client": "^15.1.3",
        "redis": "^6.3.1",
        "resend": "^6.38.0",
        "sequelize": "^6.37.8",
        "socket.io": "^4.8.4",
        "stripe": "^23.1.0",
        "uuid": "^14.0.3",
        "winston": "^3.19.0",
        "xss": "^1.0.17",
        "yup": "^1.7.1"
    }
}
