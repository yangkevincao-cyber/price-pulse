# Server Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pricepulse
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_MODE=sandbox

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@pricepulse.com
EMAIL_SUPPORT=support@pricepulse.com

# SendGrid (Alternative)
SENDGRID_API_KEY=SG.xxx

# AWS S3 (For file uploads)
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=us-east-1
AWS_BUCKET_NAME=pricepulse-uploads

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Scraping
SCRAPING_ENABLED=true
SCRAPING_INTERVAL_HOURS=24
SCRAPING_CONCURRENCY=5
PROXY_ENABLED=false

# Fraud Detection
FRAUD_DETECTION_ENABLED=true
FRAUD_RISK_THRESHOLD=0.7

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_INTERVAL_MINUTES=60

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/pricepulse/app.log

# Security
CORS_ORIGINS=http://localhost:3001,https://pricepulse.com
SESSION_SECRET=your_session_secret
ENCRYPTION_KEY=your_encryption_key_32_chars

# Feature Flags
FEATURE_DEMAND_ALERTS=true
FEATURE_PRICE_COMPARISON=true
FEATURE_EXCHANGES=true
FEATURE_SOCIAL_LOGIN=false